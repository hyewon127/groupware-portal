<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/context 
        http://www.springframework.org/schema/context/spring-context-4.0.xsd
        http://www.springframework.org/schema/mvc 
        http://www.springframework.org/schema/mvc/spring-mvc-4.0.xsd">

	<!-- 우리 프로젝트 Controller 스캔 -->
	<context:component-scan
		base-package="com.groupware">
		<context:include-filter type="annotation"
			expression="org.springframework.stereotype.Controller" />
		<context:exclude-filter type="annotation"
			expression="org.springframework.stereotype.Service" />
		<context:exclude-filter type="annotation"
			expression="org.springframework.stereotype.Repository" />
	</context:component-scan>

	<!-- MVC 어노테이션 활성화 -->
	<mvc:annotation-driven />

	<!-- JSP 뷰 경로 설정 -->
	<!-- /WEB-INF/views/ 폴더에서 .jsp 파일 찾음 -->
	<bean
		class="org.springframework.web.servlet.view.UrlBasedViewResolver"
		p:order="1"
		p:viewClass="org.springframework.web.servlet.view.JstlView"
		p:prefix="/WEB-INF/views/" p:suffix=".jsp" />

	<!-- 파일 업로드 설정 CommonsMultipartResolver: commons-fileupload 를 사용해서 multipart/form-data 
		요청을 MultipartFile 객체로 변환해줌 maxUploadSize: 업로드 최대 파일 크기 (50MB = 50 * 1024 
		* 1024) defaultEncoding: 파일명 한글 깨짐 방지 -->
	<bean id="multipartResolver"
		class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
		<property name="maxUploadSize" value="52428800" />
		<property name="defaultEncoding" value="UTF-8" />
	</bean>
</beans>