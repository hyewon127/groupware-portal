		<typeAlias alias="userVO"   type="com.groupware.user.UserVO" />
		<typeAlias alias="noticeVO"     type="com.groupware.notice.NoticeVO"/>
		<typeAlias alias="noticeReadVO" type="com.groupware.notice.NoticeReadVO"/>
		<typeAlias alias="NoticeAttachFileVO" type="com.groupware.notice.AttachFileVO"/>
		<typeAlias alias="boardVO" type="com.groupware.board.BoardVO"/>
		<typeAlias alias="BoardAttachFileVO" type="com.groupware.board.AttachFileVO"/>
		<typeAlias alias="commentVO" type="com.groupware.board.CommentVO"/>
		<typeAlias alias="scheduleVO" type="com.groupware.schedule.ScheduleVO"/>
		<typeAlias alias="messageVO" type="com.groupware.message.MessageVO"/>
    </typeAliases>
</configuration>